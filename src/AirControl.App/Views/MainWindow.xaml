<Window x:Class="AirControl.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AirControl.App.Views"
        xmlns:converters="clr-namespace:AirControl.App.Converters"
        Title="AIR Control" Height="560" Width="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:TrimDbToDisplayConverter x:Key="TrimDbToDisplayConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,4" FontSize="14" FontWeight="Bold"
                   Text="{Binding DeviceStatus.StatusText}"
                   AutomationProperties.Name="Status de conexão do AIR 192|4"
                   AutomationProperties.LiveSetting="Polite" />

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock FontSize="9" Foreground="Gray"
                       Text="{Binding CaptureFormatDescription, StringFormat={}Captura: {0}}"
                       Visibility="{Binding CaptureFormatDescription, Converter={StaticResource NullToVisibilityConverter}}" />

            <!-- FR-015c: pausa de reconfiguração é deliberada e curta — sinalizada para nunca ser
                 confundida com o congelamento da US2 logo abaixo. -->
            <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#0B5FA5" TextWrapping="Wrap"
                       Text="{Binding ReconfigurationMessage}"
                       Visibility="{Binding ReconfigurationMessage, Converter={StaticResource NullToVisibilityConverter}}"
                       AutomationProperties.Name="Estado da reconfiguração do dispositivo"
                       AutomationProperties.LiveSetting="Polite" />

            <!-- US2/FR-007: um fluxo parado nunca é silencioso — estado transitório de recuperação ou
                 erro acionável, no mesmo padrão de mensagem das demais seções (Constitution III). -->
            <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#B00020" TextWrapping="Wrap"
                       Text="{Binding StreamHealthMessage}"
                       Visibility="{Binding StreamHealthMessage, Converter={StaticResource NullToVisibilityConverter}}"
                       AutomationProperties.Name="Estado do fluxo de áudio"
                       AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>

        <views:InputDeviceSelectorView Grid.Row="2" Margin="0,0,0,8" DataContext="{Binding InputDeviceSelector}" />

        <views:RoutingModeSelectorView Grid.Row="3" Margin="0,0,0,8" DataContext="{Binding RoutingModeSelector}" />

        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <views:RecordingFormatSelectorView Margin="0,0,0,8" DataContext="{Binding RecordingFormatSelector}" />
            <views:DriverSettingsView DataContext="{Binding DriverSettings}" />
        </StackPanel>

        <ToggleButton Grid.Row="5" Margin="0,0,0,12" Padding="6,4" HorizontalAlignment="Left"
                      Content="Monitoração ativa"
                      IsChecked="{Binding Monitoring.IsMonitoringEnabled, Mode=TwoWay}"
                      AutomationProperties.Name="Habilitar ou desabilitar a monitoração audível"
                      AutomationProperties.HelpText="Quando desabilitado, a saída de áudio fica em silêncio, mas os meters continuam funcionando"
                      AutomationProperties.LiveSetting="Assertive" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <StackPanel Margin="0,0,24,0" Width="150">
                <views:MeterControl ChannelLabel="Input 1"
                                     PeakDb="{Binding Input1Meter.PeakDb}"
                                     RmsDb="{Binding Input1Meter.RmsDb}"
                                     IsClipping="{Binding Input1Meter.IsClipping}"
                                     IsDeviceConnected="{Binding Input1Meter.IsDeviceConnected}" />

                <TextBlock Text="Trim (dB)" FontSize="10" Margin="0,12,0,0" />
                <Slider x:Name="Input1TrimSlider"
                        Minimum="{Binding Input1Trim.SliderFloorDb}"
                        Maximum="{Binding Input1Trim.MaxDb}"
                        Value="{Binding Input1Trim.TrimDb, Mode=TwoWay}"
                        TickFrequency="6" TickPlacement="BottomRight" IsSnapToTickEnabled="False"
                        AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1"
                        AutomationProperties.Name="Trim do Input 1"
                        AutomationProperties.HelpText="Ajusta o ganho digital do Input 1 entre -∞ (silêncio) e +10 dB" />
                <Grid>
                    <!-- A faixa é -60 (piso do slider) a +10, não simétrica: "0" fica a 60/70 do
                         caminho, não no centro — colunas proporcionais mantêm o rótulo alinhado
                         com a posição real do valor 0 no Slider acima. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60*" />
                        <ColumnDefinition Width="10*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="-∞" FontSize="9" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="0" Text="0" FontSize="9" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="1" Text="+10" FontSize="9" HorizontalAlignment="Right" />
                </Grid>

                <Grid Margin="0,4,0,0">
                    <TextBlock Text="{Binding Input1Trim.TrimDb, Converter={StaticResource TrimDbToDisplayConverter}}"
                               HorizontalAlignment="Center" FontSize="10" />
                    <Button Content="Reset" Padding="6,0" FontSize="10" HorizontalAlignment="Right"
                            Command="{Binding Input1Trim.ResetCommand}"
                            AutomationProperties.Name="Resetar trim do Input 1 para 0 dB" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <ToggleButton Content="Mute" Padding="4" Margin="0,0,4,0"
                                  IsChecked="{Binding Input1Mute.IsMuted, Mode=TwoWay}"
                                  AutomationProperties.Name="Mute do Input 1"
                                  AutomationProperties.LiveSetting="Assertive" />
                    <ToggleButton Content="Solo" Padding="4"
                                  IsChecked="{Binding Input1Solo.IsSoloed, Mode=TwoWay}"
                                  AutomationProperties.Name="Solo do Input 1"
                                  AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </StackPanel>

            <StackPanel Width="150">
                <views:MeterControl ChannelLabel="Input 2"
                                     PeakDb="{Binding Input2Meter.PeakDb}"
                                     RmsDb="{Binding Input2Meter.RmsDb}"
                                     IsClipping="{Binding Input2Meter.IsClipping}"
                                     IsDeviceConnected="{Binding Input2Meter.IsDeviceConnected}" />

                <TextBlock Text="Trim (dB)" FontSize="10" Margin="0,12,0,0" />
                <Slider x:Name="Input2TrimSlider"
                        Minimum="{Binding Input2Trim.SliderFloorDb}"
                        Maximum="{Binding Input2Trim.MaxDb}"
                        Value="{Binding Input2Trim.TrimDb, Mode=TwoWay}"
                        TickFrequency="6" TickPlacement="BottomRight" IsSnapToTickEnabled="False"
                        AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1"
                        AutomationProperties.Name="Trim do Input 2"
                        AutomationProperties.HelpText="Ajusta o ganho digital do Input 2 entre -∞ (silêncio) e +10 dB" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60*" />
                        <ColumnDefinition Width="10*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="-∞" FontSize="9" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="0" Text="0" FontSize="9" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="1" Text="+10" FontSize="9" HorizontalAlignment="Right" />
                </Grid>

                <Grid Margin="0,4,0,0">
                    <TextBlock Text="{Binding Input2Trim.TrimDb, Converter={StaticResource TrimDbToDisplayConverter}}"
                               HorizontalAlignment="Center" FontSize="10" />
                    <Button Content="Reset" Padding="6,0" FontSize="10" HorizontalAlignment="Right"
                            Command="{Binding Input2Trim.ResetCommand}"
                            AutomationProperties.Name="Resetar trim do Input 2 para 0 dB" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <ToggleButton Content="Mute" Padding="4" Margin="0,0,4,0"
                                  IsChecked="{Binding Input2Mute.IsMuted, Mode=TwoWay}"
                                  AutomationProperties.Name="Mute do Input 2"
                                  AutomationProperties.LiveSetting="Assertive" />
                    <ToggleButton Content="Solo" Padding="4"
                                  IsChecked="{Binding Input2Solo.IsSoloed, Mode=TwoWay}"
                                  AutomationProperties.Name="Solo do Input 2"
                                  AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
