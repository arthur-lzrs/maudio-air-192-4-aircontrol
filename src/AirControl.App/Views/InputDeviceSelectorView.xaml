<UserControl x:Class="AirControl.App.Views.InputDeviceSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="260">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Margin="0,0,0,4" Text="Dispositivo de entrada" />
        <ComboBox ItemsSource="{Binding AvailableDevices}"
                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                  DisplayMemberPath="FriendlyName"
                  AutomationProperties.Name="Seletor de dispositivo de entrada" />
        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="Red" TextWrapping="Wrap"
                   Text="Nenhum dispositivo de entrada selecionado. Escolha um dispositivo acima."
                   Visibility="{Binding NeedsSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                   AutomationProperties.Name="Aviso: nenhum dispositivo de entrada selecionado"
                   AutomationProperties.LiveSetting="Assertive" />
    </StackPanel>
</UserControl>
