<UserControl x:Class="AirControl.App.Views.DriverSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:AirControl.App.Converters"
             mc:Ignorable="d" d:DesignWidth="260">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel Visibility="{Binding IsAirDeviceActive, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock Margin="0,0,0,4" Text="Driver M-Audio" />
        <TextBlock FontSize="10" TextWrapping="Wrap"
                   Text="{Binding DiagnosticInfo}"
                   AutomationProperties.Name="Diagnóstico do driver M-Audio" />

        <TextBlock Margin="0,6,0,4" Text="Sample rate do driver (ASIO)" />
        <ComboBox ItemsSource="{Binding AvailableSampleRates}"
                  SelectedItem="{Binding SelectedSampleRate, Mode=TwoWay}"
                  AutomationProperties.Name="Seletor de sample rate do driver ASIO" />

        <Border Margin="0,8,0,0" Padding="6" BorderThickness="1" BorderBrush="OrangeRed"
                Visibility="{Binding SampleRateMismatchWarning, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel>
                <TextBlock FontSize="10" FontWeight="Bold" Foreground="OrangeRed" TextWrapping="Wrap"
                           Text="{Binding SampleRateMismatchWarning}"
                           AutomationProperties.Name="Aviso de descasamento de sample rate"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Margin="0,4,0,0" Padding="6,2" HorizontalAlignment="Left"
                        Content="Abrir configurações de som do Windows"
                        Command="{Binding OpenWindowsSoundSettingsCommand}"
                        AutomationProperties.Name="Abrir configurações de som do Windows" />
            </StackPanel>
        </Border>

        <Button Margin="0,6,0,0" Padding="6,2" HorizontalAlignment="Left"
                Content="Abrir painel M-Audio (buffer size)"
                Command="{Binding OpenManufacturerPanelCommand}"
                AutomationProperties.Name="Abrir painel M-Audio para ajustar buffer size"
                AutomationProperties.HelpText="O buffer size não pode ser ajustado pelo AirControl — o protocolo ASIO não expõe isso como preferência gravável; use o painel do fabricante" />
        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="Red" TextWrapping="Wrap"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"
                   AutomationProperties.Name="Aviso do painel M-Audio"
                   AutomationProperties.LiveSetting="Assertive" />
    </StackPanel>
</UserControl>
