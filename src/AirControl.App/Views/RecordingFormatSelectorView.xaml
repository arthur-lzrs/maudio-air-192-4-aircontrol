<UserControl x:Class="AirControl.App.Views.RecordingFormatSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:AirControl.App.Converters"
             mc:Ignorable="d" d:DesignWidth="260">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel Visibility="{Binding IsAirDeviceActive, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock Margin="0,0,0,4" Text="Formato de gravação (Windows)" />
        <!-- FR-011/FR-015: abrir a lista é o gatilho discreto que consulta o sample rate do driver
             em tempo real DENTRO de uma pausa de reconfiguração (nunca com a captura ativa). -->
        <ComboBox ItemsSource="{Binding AvailableFormats}"
                  SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                  DropDownOpened="OnFormatListDropDownOpened"
                  AutomationProperties.Name="Seletor de formato de gravação" />
        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="Red" TextWrapping="Wrap"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"
                   AutomationProperties.Name="Aviso de formato de gravação"
                   AutomationProperties.LiveSetting="Assertive" />
    </StackPanel>
</UserControl>
